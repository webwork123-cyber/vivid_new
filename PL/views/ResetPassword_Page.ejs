<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Vivid — Reset Password</title>
  <link rel="stylesheet" href="/css/Login_Page.css"/>
</head>
<body>

<div class="auth-wrapper">

  <div class="side">
    <a class="logo" href="/admin/login">
      <svg class="logo-mark" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M15 30 Q20 75 50 85 Q80 75 85 30 Q65 55 50 58 Q35 55 15 30Z" fill="#818cf8"/>
        <path d="M25 18 Q30 50 50 60 Q70 50 75 18 Q60 38 50 40 Q40 38 25 18Z" fill="#c7d2fe"/>
      </svg>
      <span class="logo-text">Vivid</span>
    </a>

    <div class="side-body">
      <h2>Create a<br>new password.</h2>
      <p>Use the OTP sent to your email and choose a strong new password.</p>
    </div>

    <div class="side-link">
      Back to login? <a href="/admin/login">Sign in</a>
    </div>
  </div>

  <div class="main">
    <p class="form-head">Reset password</p>
    <p class="form-sub">Enter your OTP and new password.</p>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (message) { %>
      <div class="alert alert-success"><%= message %></div>
    <% } %>

    <form action="/admin/reset-password" method="POST">
      <div class="field">
        <label for="email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          value="<%= email || '' %>"
          placeholder="hello@vivid.io"
          required
          autocomplete="email"
        />
      </div>

      <div class="field">
        <label for="otp">OTP Code</label>
        <input
          type="text"
          id="otp"
          name="otp"
          placeholder="123456"
          required
        />
      </div>

      <div class="field">
        <label for="newPassword">New Password</label>
        <input
          type="password"
          id="newPassword"
          name="newPassword"
          placeholder="••••••••"
          required
          autocomplete="new-password"
        />
      </div>

      <div class="field">
        <label for="admin_code">Admin Code</label>
        <input
          type="password"
          id="admin_code"
          name="admin_code"
          placeholder="Required for admin accounts"
        />
      </div>

      <button type="submit" class="btn btn-primary">Reset password</button>
    </form>

    <div class="divider">or</div>

    <a href="/admin/forgot-password" class="btn btn-ghost">Request new OTP</a>
  </div>

</div>

</body>
</html>