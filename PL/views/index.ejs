  <script>
    (function () {
      const carousel = document.getElementById('carousel');
      const track = document.getElementById('carouselSlides');
      const dots = document.querySelectorAll('.carousel-dot');
      const slides = document.querySelectorAll('.carousel-slide');
      const nextBtn = document.getElementById('carouselNext');
      const prevBtn = document.getElementById('carouselPrev');
      const total = slides.length;

      if (!carousel || !track || total === 0) return;

      let cur = 0;
      let timer;
      let startX = 0;
      let endX = 0;

      function go(n) {
        cur = (n + total) % total;
        track.style.transform = `translateX(-${cur * 100}%)`;
        dots.forEach((d, i) => d.classList.toggle('active', i === cur));
      }

      function reset() {
        clearInterval(timer);
        timer = setInterval(() => go(cur + 1), 5500);
      }

      if (nextBtn) nextBtn.addEventListener('click', () => { go(cur + 1); reset(); });
      if (prevBtn) prevBtn.addEventListener('click', () => { go(cur - 1); reset(); });

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => { go(index); reset(); });
      });

      carousel.addEventListener('mouseenter', () => clearInterval(timer));
      carousel.addEventListener('mouseleave', reset);

      carousel.addEventListener('touchstart', (e) => {
        startX = e.changedTouches[0].screenX;
      }, { passive: true });

      carousel.addEventListener('touchend', (e) => {
        endX = e.changedTouches[0].screenX;
        const diff = startX - endX;

        if (Math.abs(diff) > 45) {
          go(diff > 0 ? cur + 1 : cur - 1);
          reset();
        }
      }, { passive: true });

      reset();
    })();
  </script>
