<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <meta
    name="description"
    content="Explore VIVID's laboratory supplies and solutions including chromatography products, HPLC systems, laboratory filtration, laboratory instruments, pharmaceutical testing instruments and vacuum pumps."
  />

  <title>Laboratory | VIVID Separation & Filtration</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/footer.css" />
  <link rel="stylesheet" href="/css/laboratory.css" />
</head>

<body>
  <%- include("partials/navbar") %>

  <main class="laboratory-page">

    <!-- ===================== HERO ===================== -->
    <section class="lab-hero">
      <div class="lab-hero-orb-1"></div>
      <div class="lab-hero-orb-2"></div>

      <svg class="lab-hero-deco" width="340" height="340" viewBox="0 0 340 340" aria-hidden="true">
        <polygon points="170,12 308,87 308,253 170,328 32,253 32,87" fill="none" stroke="rgba(108,99,255,.18)" stroke-width="1.5"/>
        <polygon points="170,52 278,112 278,228 170,288 62,228 62,112" fill="none" stroke="rgba(108,99,255,.12)" stroke-width="1"/>
        <polygon points="170,92 248,137 248,203 170,248 92,203 92,137" fill="none" stroke="rgba(108,99,255,.08)" stroke-width="1"/>
        <circle cx="170" cy="170" r="28" fill="rgba(61,53,212,.18)" stroke="rgba(108,99,255,.30)" stroke-width="1"/>
        <circle cx="170" cy="170" r="10" fill="rgba(108,99,255,.40)"/>
      </svg>

      <div class="lab-hero-content">
        <div class="container">

          <h1 class="lab-hero-title">
            Laboratory Supplies<br />
            &amp; <em>Solutions</em>
          </h1>

          <p class="lab-hero-desc">
            Explore chromatography products, HPLC systems, laboratory instruments,
            laboratory consumables, pharmaceutical testing instruments, filtration
            solutions and vacuum pumps for modern laboratories.
          </p>

          <div class="supplier-logos" aria-label="Laboratory suppliers">
            <div class="supplier-logo">
              <img src="/images/ThermoFisher_LOGO-Fitted.jpg" alt="Thermo" />
            </div>

            <div class="supplier-logo">
              <img src="/images/Wooking.jpg" alt="Wooking" />
            </div>

            <div class="supplier-logo">
              <img src="/images/Hanon.jpg" alt="Hanon" />
            </div>

            <div class="supplier-logo">
              <img src="/images/LabIndia.jpg" alt="LabIndia" />
            </div>

            <div class="supplier-logo">
              <img src="/images/Edwardss.jpg" alt="Edwards" />
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ===================== CATEGORIES ===================== -->
    <section class="lab-section">
      <div class="container">

        <div class="lab-header">
          <h2 class="lab-section-title">
            Browse by <span>Category</span>
          </h2>

          <p class="lab-section-desc">
            Select a laboratory product line below to explore available products,
            specifications, and technical documents.
          </p>
        </div>

        <div class="lab-grid">

          <a href="/laboratory/chromatography-products" class="lab-card">
            <div class="lab-card-body">
              <h3>Chromatography Products</h3>
              <span>Explore →</span>
            </div>
          </a>

          <a href="/laboratory/hplc-system" class="lab-card">
            <div class="lab-card-body">
              <h3>HPLC System</h3>
              <span>Explore →</span>
            </div>
          </a>

          <a href="/laboratory/laboratory-filtration" class="lab-card">
            <div class="lab-card-body">
              <h3>Laboratory Filtration</h3>
              <span>Explore →</span>
            </div>
          </a>

          <a href="/laboratory/laboratory-instruments" class="lab-card">
            <div class="lab-card-body">
              <h3>Laboratory Instruments</h3>
              <span>Explore →</span>
            </div>
          </a>

          <a href="/laboratory/pharmaceutical-testing-instruments" class="lab-card">
            <div class="lab-card-body">
              <h3>Pharmaceutical Testing Instruments</h3>
              <span>Explore →</span>
            </div>
          </a>

          <a href="/laboratory/vacuum-pumps" class="lab-card">
            <div class="lab-card-body">
              <h3>Vacuum Pumps</h3>
              <span>Explore →</span>
            </div>
          </a>

        </div>

        <div class="lab-cta">
          <div class="lab-cta-left">
            <h3>Need help choosing laboratory equipment?</h3>

            <p>
              Our technical team is available to guide you through product selection,
              specifications, and custom configurations.
            </p>

            <div class="lab-cta-emails">
              <a href="mailto:sajeda@vividsf.com">sajeda@vividsf.com</a>
              <a href="mailto:lab@vividsf.com">lab@vividsf.com</a>
            </div>
          </div>

          <a href="/contact" class="lab-cta-btn">Contact Us →</a>
        </div>

      </div>
    </section>

  </main>

  <%- include("partials/footer") %>

  <script src="/js/navbar.js" defer></script>
</body>
</html>
