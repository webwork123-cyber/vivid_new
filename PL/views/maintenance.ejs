<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <meta
    name="description"
    content="VIVID Maintenance Services — Qualified engineers, 48hr response, and technical support."
  />

  <title>Maintenance | VIVID</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/footer.css" />
  <link rel="stylesheet" href="/css/maintenance.css" />
</head>

<body>

  <%- include('partials/navbar') %>

  <main class="maintenance-page">

    <!-- ===================== PAGE HEADER ===================== -->
    <section class="page-header">
      <div class="container">
        <div class="page-header-inner">

          <h1 class="page-title">
            Maintenance <span>Services</span>
          </h1>

          <p class="page-subtitle">
            Qualified engineers and trained specialists keeping your instruments
            and systems running at peak performance.
          </p>

        </div>
      </div>
    </section>

    <!-- ===================== STATS ===================== -->
    <section class="stats-bar">
      <div class="container">
        <div class="stats-inner">

          <div class="stat-item">
            <div class="stat-num">48h</div>
            <div class="stat-lbl">Response Time</div>
          </div>

          <div class="stat-item">
            <div class="stat-num">Support</div>
            <div class="stat-lbl">Technical Support</div>
          </div>

          <div class="stat-item">
            <div class="stat-num">28+</div>
            <div class="stat-lbl">Years Experience</div>
          </div>

          <div class="stat-item">
            <div class="stat-num">100%</div>
            <div class="stat-lbl">Qualified Engineers</div>
          </div>

        </div>
      </div>
    </section>

    <!-- ===================== MAIN ===================== -->
    <section class="maintenance-main">
      <div class="container">
        <div class="maintenance-grid">

          <div class="maintenance-left">

            <div class="content-block">
              <span class="section-label">Who We Are</span>

              <h2 class="section-title">
                Expert Maintenance <span>You Can Rely On</span>
              </h2>

              <p class="section-desc">
                VIVID has qualified engineers and trained specialists dedicated
                to keeping your equipment operational. Our maintenance team is
                highly skilled across all instruments and systems we supply,
                ensuring minimal downtime and maximum reliability.
              </p>
            </div>

            <div class="feature-cards">

              <div class="feature-card">
                <div class="feature-icon">⚡</div>
                <div class="feature-body">
                  <h3>48-Hour Response</h3>
                  <p>
                    We guarantee maintenance within 48 hours for all instruments
                    we supply, minimizing downtime and keeping your operations on track.
                  </p>
                </div>
              </div>

              <div class="feature-card">
                <div class="feature-icon">🛠</div>
                <div class="feature-body">
                  <h3>Highly Qualified Team</h3>
                  <p>
                    Our maintenance engineers are extensively trained and certified,
                    with deep expertise across industrial, laboratory, and powder
                    coating systems.
                  </p>
                </div>
              </div>

              <div class="feature-card">
                <div class="feature-icon">📞</div>
                <div class="feature-body">
                  <h3>Technical Support</h3>
                  <p>
                    Technical assistance is provided for our clients. Call, email,
                    or visit our team whenever you need support.
                  </p>
                </div>
              </div>

              <div class="feature-card">
                <div class="feature-icon">🔩</div>
                <div class="feature-body">
                  <h3>Spare Parts & MRO</h3>
                  <p>
                    Access to original spare parts, lubricants, and maintenance,
                    repair, and operations supplies for uninterrupted performance.
                  </p>
                </div>
              </div>

            </div>
          </div>

          <div class="maintenance-right">
            <div class="contact-panel">

              <div class="contact-panel-header">
                <span class="section-label">Get In Touch</span>

                <h3>
                  Contact Our<br>
                  <em>Maintenance Team</em>
                </h3>

                <p>
                  Reach out directly to our maintenance department for repairs,
                  field support, spare parts assistance, and technical service.
                </p>
              </div>

              <div class="contact-channels">

                <a href="mailto:maintenance@vividsf.com" class="contact-channel">
                  <div class="channel-icon-wrap maintenance">
                    <div class="channel-icon">🛠️</div>
                  </div>

                  <div class="channel-body">
                    <span class="channel-label">Maintenance Services</span>
                    <strong class="channel-value">maintenance@vividsf.com</strong>
                    <small>Repairs, maintenance & field support</small>
                  </div>

                  <div class="channel-arrow">→</div>
                </a>

              </div>

              <div class="contact-panel-footer">
                <div class="footer-note">
                  <div class="footer-note-icon">🕐</div>
                  <span>Available Sat – Thu, 8:00 AM – 6:00 PM</span>
                </div>

                <a href="/contact" class="btn-full-contact">Send a Message →</a>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

  </main>

  <%- include('partials/footer') %>

  <script src="/js/navbar.js" defer></script>
</body>
</html>
