<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <meta
    name="description"
    content="Explore VIVID's industrial products and solutions including filtration, compressed air treatment, gas generators, dust collectors, vacuum pumps, instrumentation and pneumatics."
  />

  <title>Industrial | VIVID Separation & Filtration</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/footer.css" />
  <link rel="stylesheet" href="/css/industrial.css" />
</head>

<body>
  <%- include("partials/navbar") %>

  <main class="industrial-page">

    <!-- ===================== HERO ===================== -->
    <section class="ind-hero">
      <div class="ind-hero-orb-1"></div>
      <div class="ind-hero-orb-2"></div>

      <svg class="ind-hero-deco" width="340" height="340" viewBox="0 0 340 340" aria-hidden="true">
        <polygon points="170,12 308,87 308,253 170,328 32,253 32,87" fill="none" stroke="rgba(108,99,255,.18)" stroke-width="1.5"/>
        <polygon points="170,52 278,112 278,228 170,288 62,228 62,112" fill="none" stroke="rgba(108,99,255,.12)" stroke-width="1"/>
        <polygon points="170,92 248,137 248,203 170,248 92,203 92,137" fill="none" stroke="rgba(108,99,255,.08)" stroke-width="1"/>
        <circle cx="170" cy="170" r="28" fill="rgba(61,53,212,.18)" stroke="rgba(108,99,255,.30)" stroke-width="1"/>
        <circle cx="170" cy="170" r="10" fill="rgba(108,99,255,.40)"/>
      </svg>

      <div class="ind-hero-content">
        <div class="container">

          <h1 class="ind-hero-title">
            Industrial Products<br />
            &amp; <em>Solutions</em>
          </h1>

          <p class="ind-hero-desc">
            Explore our complete range of industrial filtration, compressed air treatment,
            gas generators, dust collectors, vacuum pumps, pneumatic systems,
            instrumentation and more.
          </p>

          <div class="supplier-logos" aria-label="Industrial suppliers">
            <div class="supplier-logo">
              <img src="/images/Parker_LOGO (1).jpg" alt="Parker" />
            </div>

            <div class="supplier-logo">
              <img src="/images/Donaldson.jpg" alt="Donaldson" />
            </div>

            <div class="supplier-logo">
              <img src="/images/Edwardss.jpg" alt="Edwards" />
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ===================== CATEGORIES ===================== -->
    <section class="ind-section">
      <div class="container">

        <div class="about-header">
          <h2 class="about-title">
            Browse by <span>Category</span>
          </h2>

          <p class="about-subtitle">
            Select a product line below to explore available products,
            specifications, and technical documents.
          </p>
        </div>

        <div class="ind-grid">

          <a href="/industrial/compressed-air-systems" class="ind-card">
            <div class="ind-card-body">
              <h3 class="ind-card-title">Compressed Air Systems</h3>
              <span class="ind-card-link">Explore →</span>
            </div>
          </a>

          <a href="/industrial/dust-collectors" class="ind-card">
            <div class="ind-card-body">
              <h3 class="ind-card-title">Dust Collectors</h3>
              <span class="ind-card-link">Explore →</span>
            </div>
          </a>

          <a href="/industrial/gas-generators" class="ind-card">
            <div class="ind-card-body">
              <h3 class="ind-card-title">Gas Generators</h3>
              <span class="ind-card-link">Explore →</span>
            </div>
          </a>

          <a href="/industrial/instrumentation" class="ind-card">
            <div class="ind-card-body">
              <h3 class="ind-card-title">Instrumentation</h3>
              <span class="ind-card-link">Explore →</span>
            </div>
          </a>

          <a href="/industrial/liquid-process-filtration" class="ind-card">
            <div class="ind-card-body">
              <h3 class="ind-card-title">Liquid Process Filtration</h3>
              <span class="ind-card-link">Explore →</span>
            </div>
          </a>
           <a href="/industrial/piping-systems" class="ind-card">
            <div class="ind-card-body">
              <h3 class="ind-card-title">Piping Systems</h3>
              <span class="ind-card-link">Explore →</span>
            </div>
          </a>
          <a href="/industrial/pneumatics" class="ind-card">
            <div class="ind-card-body">
              <h3 class="ind-card-title">Pneumatics</h3>
              <span class="ind-card-link">Explore →</span>
            </div>
          </a>

          <a href="/industrial/testing-instruments" class="ind-card">
            <div class="ind-card-body">
              <h3 class="ind-card-title">Testing Instruments</h3>
              <span class="ind-card-link">Explore →</span>
            </div>
          </a>

          <a href="/industrial/vacuum-pumps" class="ind-card">
            <div class="ind-card-body">
              <h3 class="ind-card-title">Vacuum Pumps</h3>
              <span class="ind-card-link">Explore →</span>
            </div>
          </a>

        </div>

        <div class="ind-cta">
          <div class="ind-cta-left">
            <h3 class="ind-cta-title">
              Need help choosing the right solution?
            </h3>

            <p class="ind-cta-desc">
              Our technical team is available to guide you through product selection,
              specifications, and custom configurations.
            </p>

            <div class="ind-cta-emails">
              <a href="mailto:maram@vividsf.com">maram@vividsf.com</a>
              <a href="mailto:industrial@vividsf.com">industrial@vividsf.com</a>
            </div>
          </div>

          <a href="/contact" class="ind-cta-btn">Contact Us →</a>
        </div>

      </div>
    </section>

  </main>

  <%- include("partials/footer") %>

  <script src="/js/navbar.js" defer></script>
</body>
</html>
