<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Vivid — Forgot Password</title>
  <link rel="stylesheet" href="/css/Login_Page.css"/>
</head>
<body>

<div class="auth-wrapper">

  <div class="side">
    <a class="logo" href="/admin/login">
      <svg class="logo-mark" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M15 30 Q20 75 50 85 Q80 75 85 30 Q65 55 50 58 Q35 55 15 30Z" fill="#818cf8"/>
        <path d="M25 18 Q30 50 50 60 Q70 50 75 18 Q60 38 50 40 Q40 38 25 18Z" fill="#c7d2fe"/>
      </svg>
      <span class="logo-text">Vivid</span>
    </a>

    <div class="side-body">
      <h2>Reset your<br>password.</h2>
      <p>Enter your email and we’ll send you an OTP to recover your account.</p>
    </div>

    <div class="side-link">
      Remember your password? <a href="/admin/login">Sign in</a>
    </div>
  </div>

  <div class="main">
    <p class="form-head">Forgot password</p>
    <p class="form-sub">Enter your email to receive a reset OTP.</p>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (message) { %>
      <div class="alert alert-success"><%= message %></div>
    <% } %>

    <form action="/admin/forgot-password" method="POST">
      <div class="field">
        <label for="email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="hello@vivid.io"
          required
          autocomplete="email"
        />
      </div>

      <button type="submit" class="btn btn-primary">Send OTP</button>
    </form>

    <div class="divider">or</div>

    <a href="/admin/login" class="btn btn-ghost">Back to sign in</a>
  </div>

</div>

</body>
</html>